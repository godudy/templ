{
  "ui8kit": {
    "file": "ui8kit.js"
  },
  "ariaMode": "subset",
  "ariaVersion": "0.1.0",
  "patterns": [
    "alert",
    "dialog",
    "sheet",
    "tabs",
    "combobox",
    "menu",
    "menubutton",
    "popover",
    "toast"
  ],
  "hooks": {
    "dialog": [
      "data-ui8kit-dialog",
      "data-ui8kit-dialog-open",
      "data-ui8kit-dialog-close",
      "data-ui8kit-dialog-target"
    ],
    "sheet": [
      "data-ui8kit",
      "data-ui8kit-dialog",
      "data-ui8kit-dialog-open",
      "data-ui8kit-dialog-close",
      "data-ui8kit-dialog-target"
    ],
    "tabs": [
      "data-ui8kit",
      "data-tabs-trigger",
      "data-tabs-panel",
      "data-tabs-value"
    ],
    "combobox": [
      "data-ui8kit",
      "data-combobox-toggle",
      "data-combobox-option",
      "data-combobox-value"
    ],
    "menu": [
      "data-ui8kit",
      "data-menu-item"
    ],
    "menubutton": [
      "data-ui8kit",
      "data-menubutton-target"
    ],
    "popover": [
      "data-ui8kit",
      "data-ui8kit-dialog",
      "data-ui8kit-dialog-open",
      "data-ui8kit-dialog-close",
      "data-ui8kit-dialog-target"
    ],
    "toast": [
      "data-ui8kit"
    ]
  }
}
